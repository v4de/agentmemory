# Lightweight MCP shim image for the gateway to spawn as a stdio backend.
# Pre-installs @agentmemory/mcp so there's no npx cold-start delay.
# Reads AGENTMEMORY_SECRET from /run/secrets/.hmac if mounted (preferred),
# or falls back to the AGENTMEMORY_SECRET env var.
FROM node:24-slim

# Custom CA certificates (e.g. corporate proxy) — injected before npm so HTTPS repos are trusted
COPY certificates/*.crt /usr/local/share/ca-certificates/
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g @agentmemory/mcp --no-fund --no-audit \
  && npm cache clean --force

COPY --chmod=0755 shim-entrypoint.sh /usr/local/bin/shim-entrypoint.sh

ENTRYPOINT ["shim-entrypoint.sh"]
